# RecoverAI - Environment Configuration Template
# Copy this file to .env and configure your environment variables.

# Server Configuration
PORT=3000
NODE_ENV="development"
APP_URL="http://localhost:3000"

# Authentication & Security
SESSION_SECRET="recoverai_session_secret_change_in_production_key"
JWT_SECRET="recoverai_jwt_super_secret_signing_key_2026"
JWT_EXPIRES_IN="24h"

# MySQL Database Configuration
DATABASE_URL="mysql://recover_user:recover_password@127.0.0.1:3306/recoverai_db"
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME="recoverai_db"
DB_USER="recover_user"
DB_PASSWORD="recover_password"
DB_CONNECTION_LIMIT=10

# Python ML Microservice Configuration
ML_SERVICE_URL="http://127.0.0.1:8000"
ML_API_KEY=""

# Razorpay Integration (Test Mode)
RAZORPAY_KEY_ID="rzp_test_sample_key_id"
RAZORPAY_KEY_SECRET="rzp_test_sample_secret_key"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_key"

# Gemini AI API Key (Server-side)
GEMINI_API_KEY=""
